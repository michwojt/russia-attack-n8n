        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  model: \"typesafe/jev-1.13\",\n  state: $json.title + \"\\n\\n\" + $json.description + \"\\n\\n\" + $json.content,\n  questions: {\n    relevant: {\n      type: \"noul\",\n      instructions: \"Is this article relevant to a potential Russia–NATO military confrontation?\"\n    },\n    less_probable: {\n      type: \"noul\",\n      instructions: \"Does this information make Russia attack less probable?\"\n    },\n    more_probable: {\n      type: \"noul\",\n      instructions: \"Does this information make Russia attack more probable?\"\n    }\n  }\n}) }}",
        "options": {}
      },
