      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "da5b8eb5-1686-424a-b7f7-01c8c9c85da1",
              "leftValue": "={{ \n  $json.answers.relevant.noul >= $('Config').item.json.relevance_threshold &&\n  (\n    $json.answers.less_probable.noul >= $('Config').item.json.direction_threshold ||\n    $json.answers.more_probable.noul >= $('Config').item.json.direction_threshold\n  )\n}}",
              "rightValue": 0.8,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
